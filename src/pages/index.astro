          <a class="mail" href="mailto:akl@akl.io">email</a><span class="sep" aria-hidden="true">·</span>
          <a href="https://bsky.app/profile/did:plc:u2hotgrxdf5rr3zqjubs2wsb" rel="me">bluesky</a><span class="sep" aria-hidden="true">·</span>
          <a href="https://hachyderm.io/@akl" rel="me">mastodon</a><span class="sep" aria-hidden="true">·</span>
          <a href="https://linkedin.com/in/adamloghry" rel="me">linkedin</a>
