---
import Base from '../layouts/Base.astro';
import Forest from '../components/Forest.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import Colophon from '../components/Colophon.astro';
---
<Base>
  <div class="page">
    <Forest />

    <main>
      <div class="head">
        <header>
          <h1>Adam K. Loghry</h1>
          <p class="role">Senior Staff SRE and SRE lead for Google Kubernetes Engine, based in Seattle</p>
        </header>
        <ThemeToggle />
      </div>

