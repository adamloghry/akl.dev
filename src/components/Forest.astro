---
// Forest.astro — the fixed, behind-the-text stand. All visuals are CSS; geometry comes from forest.js at runtime.
// The seed is random per visit by design (the owner likes every load to be a different stand).
// Query overrides for QA: ?seed=N  ?rain=on|off  ?moon=on|off
---
<svg class="moon" id="moon" viewBox="0 0 40 40" aria-hidden="true">
  <path d="M20 4 A16 16 0 1 0 20 36 A12.5 12.5 0 1 1 20 4 Z" fill="none" stroke="currentColor" stroke-width="0.9" stroke-linejoin="round"></path>
</svg>

<div class="forest" id="forest" aria-hidden="true">
  <div class="stand" id="stand"></div>
  <div class="rain" id="rain"></div>
</div>

<script>
  import { DEFAULT_CONFIG, buildForest, buildRain, fitStand, seattleNow, wxRain, wxNight, randomSeed } from '../scripts/forest.js';
  import { pauseWhenHidden } from '../scripts/pause';

  // Density (owner, docs/design.md section 3). The handoff's counts are fixed, so a wide stand is a sparse one.
  // Counts scale with the stand's layout width (innerWidth / --fs) from the width the design was drawn at,
  // never below the handoff's counts. Rain is not inside the scaled stand, so it scales with the window width.
  const REF_STAND_W = 1950, REF_RAIN_W = 1440, MAX_DENSITY = 3, REBUILD_AT = 0.2;
  const clampK = (k: number) => Math.min(MAX_DENSITY, Math.max(1, k));
  const standK = (fs: number) => clampK(innerWidth / fs / REF_STAND_W);
  const rainK = () => clampK(innerWidth / REF_RAIN_W);
  const scaled = (k: number) => ({
    ...DEFAULT_CONFIG,
    layers: DEFAULT_CONFIG.layers.map((L) => ({ ...L, count: Math.round(L.count * k) })),
    rain: { ...DEFAULT_CONFIG.rain, count: Math.round(DEFAULT_CONFIG.rain.count * rainK()) },
  });

  const q = new URLSearchParams(location.search);
  const now = seattleNow();
  const rainOn = q.has('rain') ? q.get('rain') !== 'off' : wxRain(now);
  const night  = q.has('moon') ? q.get('moon') !== 'off' : wxNight(now);
  let seed = randomSeed();
  if (q.has('seed')) seed = parseInt(q.get('seed')!, 10) >>> 0;

  const stand = document.getElementById('stand')!;
  const rain = document.getElementById('rain')!;
  const main = document.querySelector('main');
  const born = performance.now();
  let builtK = 0;
  // Fit first (the scale decides the stand's layout width), then build at that width's density. A resize that moves
  // the density by more than REBUILD_AT rebuilds from the same seed; --age (overrides.css) keeps a rebuilt stand as
  // far along its grow-in as the page is, so nothing regrows from the ground.
  const fit = () => {
    const k = standK(fitStand(stand, main));
    if (builtK && Math.abs(k / builtK - 1) <= REBUILD_AT) return;
    const cfg = scaled(k);
    stand.style.setProperty('--age', ((performance.now() - born) / 1000).toFixed(1) + 's');
    stand.replaceChildren(); rain.replaceChildren();
    buildForest(stand, seed, cfg);
    if (rainOn) buildRain(rain, seed ^ 0x9e3779b9, cfg);
    builtK = k;
  };
  fit();

  const moon = document.getElementById('moon')!;
  const isDark = () => {
    const t = document.documentElement.getAttribute('data-theme');
    return t === 'dark' ? true : t === 'light' ? false : matchMedia('(prefers-color-scheme: dark)').matches;
  };
  const syncMoon = () => moon.classList.toggle('on', isDark() && night);
  syncMoon();
  document.addEventListener('themechange', syncMoon);
  matchMedia('(prefers-color-scheme: dark)').addEventListener('change', syncMoon);

  // iOS fires resize as the toolbar collapses while scrolling (innerHeight only): ignore small height-only changes.
  let t: ReturnType<typeof setTimeout>, lw = innerWidth, lh = innerHeight;
  addEventListener('resize', () => {
    clearTimeout(t);
    t = setTimeout(() => {
      if (innerWidth === lw && Math.abs(innerHeight - lh) <= 150) return;
      lw = innerWidth; lh = innerHeight; fit();
    }, 80);
  });
  if (document.fonts && document.fonts.ready) document.fonts.ready.then(fit);
  pauseWhenHidden(document.getElementById('forest')!, moon);
</script>
